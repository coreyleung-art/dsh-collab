#!/usr/bin/env python3
"""卡 JSON 内容引号修正：只把【内容里的 ASCII 双引号】换成汉字引号，保留 4 个结构位。

由来（2026-09-22）：明鉴在内容里引用词/短语时习惯打 ASCII 引号，该错已重复 4 次。
  前三次靠「记得一次写对」全部失败 ⇒ 根因不是"不小心"，是【写作习惯】。
  而修正动作本身也难以可靠（第 3 次我用脚本改，把「值的开头引号」也改了 —— 因为我以为结构位是 3 个，实际是 4 个）。
  ⇒ 所以把【检测】与【修正】都机械化：
      检测 = card-json-check（已可靠，四次全拦住、零流出）
      修正 = 本脚本（结构位 = 每行第 1、2、3 与最后一个 ASCII 引号）

用法：python3 fix-card-quotes.py <card.json> [--dry-run]
退出码：0 = 已合法或已修好；1 = 修完仍不合法
"""
import json, sys

def fix_line(ln):
    pos = [i for i, ch in enumerate(ln) if ch == '"']
    if len(pos) <= 4:
        return ln, 0
    # 结构位：键名两个（pos[0], pos[1]）+ 值开头（pos[2]）+ 值结尾（pos[-1]）
    keep = {pos[0], pos[1], pos[2], pos[-1]}
    out, open_q, n = [], True, 0
    for i, ch in enumerate(ln):
        if ch == '"' and i not in keep:
            out.append('「' if open_q else '」'); open_q = not open_q; n += 1
        else:
            out.append(ch)
    return "".join(out), n

def main():
    path = sys.argv[1]
    dry = "--dry-run" in sys.argv
    lines = open(path, encoding="utf-8").read().split("\n")
    total = 0
    for i, ln in enumerate(lines):
        new, n = fix_line(ln)
        if n:
            lines[i] = new; total += n
            print(f"  line {i+1}: 修 {n} 处")
    s = "\n".join(lines)
    try:
        d = json.loads(s)
    except Exception as e:
        print("修完仍不合法:", str(e)[:120]); return 1
    print(f"合计修 {total} 处 · 解析 ✅ · 字段数 {len(d)}")
    if not dry:
        open(path, "w", encoding="utf-8").write(s)
        print("已写回")
    else:
        print("(--dry-run，未写回)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
