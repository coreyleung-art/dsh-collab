  stCard.innerHTML='<h3>📐 蓝图状态速览</h3><div style="margin:8px 0">'+
    ['done','active','partial','todo'].map(st=>{
      const n=sts[st]||0,names={done:'✅ 完成',active:'🟢 进行中',partial:'🟡 部分',todo:'⬜ 待启动'};
