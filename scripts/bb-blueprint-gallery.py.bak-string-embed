  var gv=document.getElementById('gv-link');if(gv)gv.onclick=function(e){e.preventDefault();switchTab('versions')};
  box.appendChild(verCard);
  // 🧭 自进化信号：孤岛探测卡
  const isoCard=el('div','card');isoCard.id='island-card';
  isoCard.innerHTML='<h3>🧭 自进化信号 · 孤岛探测</h3><div style="color:#8b90a3;font-size:12px;margin:6px 0">检测中…</div>';
