      Object.keys(d.termDist||{}).map(k=>'<span style="font-size:12px"><b style="color:#6ea8ff;font-size:16px">'+(d.termDist[k]||0)+'</b> '+k+'</span>').join('')+'</div>';
    box.appendChild(td);
  }).catch(e=>box.appendChild(el('div','empty','加载失败')));
