    box.appendChild(mu);
    // 4) 词频分布
    const td=el('div','');td.style.cssText='margin-top:14px';
    td.innerHTML='<div style="font-size:12px;color:#8b90a3;margin-bottom:6px">📊 体系高频词 · 文档提及频次</div>'+
