{
  "name": "dsh-plugin-self-report-gate",
  "version": "1.0.0",
  "description": "自述可证性门（R-SR）：SR1 现场重测 / SR2 阳性对照 / SR3 撤回传播 / SR4 写盘自证 / SR5 环境指纹 / SR6 修复路径覆盖（R006 十项骨架 · 由 PSTD 模式 P2 生成）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "selfcheck": "node cli.js --selfcheck",
    "lean4-check": "node cli.js --lean4-check",
    "dry-run": "node cli.js --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "r006": {
    "category": "engineering",
    "scope": "local",
    "status": "enforced",
    "cli_form": true,
    "tcc_selfcheck": true,
    "cld_adaptive": true,
    "dsh_adaptive": true,
    "documented": "docs/README.md",
    "versioned": true,
    "unified_log": "~/dsh-collab/logs/dsh-plugin-self-report-gate.log",
    "auto_chain": "data/registry/dsh-plugin-self-report-gate 登记卡",
    "cli_governance": "严格 parseArgs（未知旗标 exit 2）+ 退出码 0/1/2 + --dry-run 零变更 + --json + --help",
    "lean4_gate": "lib/gate.js 冻结枚举 + 负例矩阵 + 命令白名单 + --lean4-check 六项 A–F",
    "naming": "PSTD PSTD/1.0.4（N1–N8）；idPrefix=srg；工具数=1"
  }
}
