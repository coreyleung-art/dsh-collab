{
  "name": "dsh-plugin-item-validity-review-check",
  "version": "1.0.0",
  "description": "条目有效性审查：对一张卡/一条待办/一个条目回答「它现在还有效吗」——先分形态（action/record/feed/ack/unknown），再给五态（closed/stale/open/unknown/n/a），附每态所依赖的条件量与回复可见性三通道（A 卡内指针 / B 线程记录 / C 指针形态），输出五态 + 条件量 + 盲区声明（R006 十项 · PSTD P2）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "selfcheck": "node cli.js --selfcheck",
    "lean4-check": "node cli.js --lean4-check",
    "dry-run": "node cli.js --dry-run",
    "selftest": "node cli.js --selftest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "r006": {
    "category": "engineering",
    "scope": "local",
    "status": "enforced",
    "cli_form": true,
    "tcc_selfcheck": true,
    "cld_adaptive": true,
    "dsh_adaptive": true,
    "documented": "docs/README.md",
    "versioned": true,
    "unified_log": "~/dsh-collab/logs/dsh-plugin-item-validity-review-check.log",
    "auto_chain": "data/registry/dsh-plugin-item-validity-review-check 登记卡",
    "cli_governance": "严格 parseArgs（未知旗标 exit 2）+ 退出码 0/1/2 + --dry-run 零变更 + --json + --help",
    "lean4_gate": "lib/gate.js 冻结枚举 + 负例矩阵 + 命令白名单 + --lean4-check 六项 A–F",
    "naming": "PSTD PSTD/1.0.4（N1–N8）；idPrefix=ivrc；工具数=4"
  }
}
