{
  "name": "dsh-plugin-writing-guards",
  "version": "1.0.0",
  "description": "写作过程守卫：非原子写扫描 · 数字口径申报 · 更正账生成 · 照抄旧读数疑似检测 · 既有 lint 清单（独立 CLI 工具 · R006 骨架 · 由 PSTD 模式 P3 生成）",
  "type": "module",
  "main": "cli.js",
  "bin": {
    "writing-guards": "cli.js"
  },
  "scripts": {
    "selfcheck": "node cli.js --selfcheck",
    "lean4-check": "node cli.js --lean4-check",
    "dry-run": "node cli.js --dry-run"
  },
  "exports": {
    ".": {
      "default": "./cli.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {},
  "r006": {
    "category": "engineering",
    "scope": "local",
    "status": "enforced",
    "cli_form": true,
    "tcc_selfcheck": true,
    "cld_adaptive": true,
    "dsh_adaptive": true,
    "documented": "docs/README.md",
    "versioned": true,
    "unified_log": "~/dsh-collab/logs/dsh-plugin-writing-guards.log",
    "auto_chain": "data/registry/dsh-plugin-writing-guards 登记卡",
    "cli_governance": "严格 parseArgs（未知旗标 exit 2）+ 退出码 0/1/2 + --dry-run 零变更 + --json + --help",
    "lean4_gate": "lib/gate.js 冻结枚举 + 负例矩阵 + 命令白名单 + --lean4-check 六项 A–F",
    "exemption": "CLI 形态：① 不适用（无 cordis.patch.yml 行）；②⑥⑦⑨⑩ 仍强制",
    "naming": "PSTD PSTD/1.0.4（N1–N8）；idPrefix=writin"
  }
}
