{
  "name": "dsh-plugin-context-survival",
  "version": "0.2.0",
  "description": "上下文存活守卫（K2 只测量）：与官方 compaction-basic 并存、不替换 ctx.compaction，在会话到达压缩器开销下界之前用非摘要检查点压低活跃窗口",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "selfcheck": "node cli.js --selfcheck",
    "lean4-check": "node cli.js --lean4-check",
    "dry-run": "node cli.js --dry-run",
    "budget-check": "node cli.js --budget-check",
    "test": "node --test lib/budget.test.js lib/guard.test.js"
  },
  "bin": {
    "csx": "cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "r006": {
    "category": "engineering",
    "scope": "mac-mini",
    "status": "measure-only",
    "cli_form": true,
    "tcc_selfcheck": true,
    "cld_adaptive": true,
    "dsh_adaptive": true,
    "documented": "docs/README.md",
    "versioned": true,
    "unified_log": "~/dsh-collab/logs/dsh-plugin-context-survival.log",
    "auto_chain": "rules-registry/RULES.md R006 + R049 + data/registry/dsh-plugin-context-survival",
    "cli_governance": "argparse 式校验 + 退出码 0/1/2",
    "lean4_gate": "lib/gate.js 零外部命令证明 + 召回目标枚举化 + 宿主端 inject 白名单",
    "note": "K2 = 只测量（lib/budget.js 纯决策核 + lib/guard.js 观察器 + --budget-check 进程内自检）。检查点产出与表面替换在 K3。"
  }
}
