#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
guard-cld-release — CLD 版本管理工具（《CLD版本管理清单》机械执行）

用法：
  guard-cld-release status                 # 现役全资产指纹(asar/icon/my-brand/runtime) + 版本判定
  guard-cld-release tag <ver> [--note …]   # 给现役打语义版本标 → ~/.dsh/cld-release.json
  guard-cld-release history                # 显示版本登记史(JSON)
  guard-cld-release rollback <ver|backup>  # 回滚 asar 到某备份(先自动备份当前, 再恢复+重签提示)
  guard-cld-release verify                 # 核对现役指纹与登记的当前版本是否一致
状态: ~/.dsh/cld-release.json (MBP: ~/dsh-collab/guard/state/cld-release.json 或 .dsh)
"""
import hashlib
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CLD_APP = "/Applications/CLD.app/Contents/Resources"
ASAR = os.path.join(CLD_APP, "app.asar")
ICON = os.path.join(CLD_APP, "icon.icns")
MYBRAND = os.path.join(HOME, "dsh-plugin-my-brand", "lib", "client.js")
BACKUPS = os.path.join(HOME, "dsh-collab", "guard", "backups")
STATE = os.path.join(HOME, ".dsh", "cld-release.json")


def sha1f(fp):
    try:
        return hashlib.sha1(open(fp, "rb").read()).hexdigest()[:16]
    except Exception:
        return None


def size(fp):
    try:
        return os.path.getsize(fp)
    except Exception:
        return None


def read_state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {"versions": [], "current": None}


def write_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    json.dump(st, open(STATE, "w"), ensure_ascii=False, indent=1)


def mybrand_ver():
    try:
        head = open(MYBRAND).read(200)
        m = [l for l in head.splitlines() if "v0." in l][:1]
        return m[0].strip()[:80] if m else "?"
    except Exception:
        return "?"


def runtime_ver():
    pj = "/Applications/CLD.app/Contents/Resources/dsh-runtime/runtime/node_modules/@deepseek-ai/dsh/package.json"
    try:
        return json.load(open(pj)).get("version", "?")
    except Exception:
        return "?"


def runtime_patch_sha():
    """runtime 补丁指纹: dsh-agent-loop(孤儿修复) + 其它已 patch 的 runtime 文件"""
    f = "/Applications/CLD.app/Contents/Resources/dsh-runtime/runtime/node_modules/@deepseek-ai/dsh-agent-loop/lib/index.js"
    try:
        return hashlib.sha1(open(f, "rb").read()).hexdigest()[:16]
    except Exception:
        return None


def guard_plugin_ver():
    """dsh-plugin-guard 插件版本指纹(取工具数)"""
    f = os.path.join(HOME, "dsh-plugin-guard", "lib", "index.js")
    try:
        c = open(f).read()
        import re
        tools = re.findall(r'name: "guard_[a-z_]+"', c)
        return f"v0.3({len(tools)}tools)"
    except Exception:
        return "?"


def snapshot():
    return {
        "asar_sha1": sha1f(ASAR), "asar_size": size(ASAR),
        "icon_sha1": sha1f(ICON), "icon_size": size(ICON),
        "mybrand": mybrand_ver(), "runtime": runtime_ver(),
        "runtime_patch": runtime_patch_sha(), "guard_plugin": guard_plugin_ver(),
        "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
    }


def cmd_status():
    s = snapshot()
    st = read_state()
    cur = st.get("current") or {}
    print("=== CLD 现役指纹 ===")
    for k in ("asar_sha1", "asar_size", "icon_sha1", "icon_size", "mybrand", "runtime", "runtime_patch", "guard_plugin"):
        print(f"  {k}: {s.get(k)}")
    if cur.get("ver") and cur.get("asar_sha1") == s.get("asar_sha1"):
        print(f"\n✅ 与登记版本一致: {cur['ver']} ({cur.get('note','')})")
    elif cur.get("ver"):
        print(f"\n⚠️ 现役 asar ≠ 登记 {cur.get('ver')} —— 尚未 tag 或已改动")
        print(f"   登记: {cur.get('asar_sha1')} vs 现役: {s.get('asar_sha1')}")
    else:
        print("\nℹ 尚未登记版本（首次 tag: guard-cld-release tag vX.Y.Z --note …）")
    return 0


def cmd_tag(ver, note):
    s = snapshot()
    st = read_state()
    st["versions"].append({"ver": ver, "note": note, **s})
    st["current"] = {"ver": ver, "note": note, "asar_sha1": s["asar_sha1"], "ts": s["ts"]}
    write_state(st)
    print(f"✅ 已登记 {ver}: asar {s['asar_sha1']} / my-brand {s['mybrand']}")
    return 0


def cmd_history():
    st = read_state()
    vs = st.get("versions", [])
    print(f"=== 版本登记史 ({len(vs)}) ===")
    for v in reversed(vs[-20:]):
        print(f"  {v.get('ver','')} {v.get('ts','')}  asar {str(v.get('asar_sha1',''))[:10]}  {v.get('note','')}")
    return 0


def cmd_rollback(target):
    # 支持传版本号(从登记史找)或备份文件名关键词
    st = read_state()
    backup = None
    if os.path.exists(os.path.join(BACKUPS, target)):
        backup = os.path.join(BACKUPS, target)
    else:
        # 模糊: 版本登记里的 asar_sha1 匹配备份? 备份无 sha 索引; 用文件名含 target 或登记 note
        cands = [f for f in os.listdir(BACKUPS) if "app.asar" in f and (target in f or target in os.path.basename(f))]
        if len(cands) == 1:
            backup = os.path.join(BACKUPS, cands[0])
        elif not cands:
            print("❌ 未找到匹配备份。用: guard-cld-release rollback <backup文件名> 或 ls backups")
            return 1
        else:
            print("⚠️ 多个匹配:")
            for c in cands:
                print("  ", c)
            print("请指定完整文件名")
            return 1
    # 备份当前
    ts = time.strftime("%Y%m%d-%H%M%S")
    cur_bak = os.path.join(BACKUPS, f"Applications__CLD.app__Contents__Resources__app.asar.bak-good-{ts}-pre-rollback")
    try:
        subprocess.run(["cp", ASAR, cur_bak], check=True)
        print(f"📦 当前已备份: {os.path.basename(cur_bak)}")
        subprocess.run(["cp", backup, ASAR], check=True)
        print(f"✅ asar 已回滚 ← {os.path.basename(backup)}")
        print("⚠️ 需重签+重启:")
        print("   codesign --force --sign - /Applications/CLD.app/Contents/Resources/app.asar")
        print("   然后完全退出重启 CLD")
        return 0
    except Exception as e:
        print("❌ 回滚失败:", str(e)[:200])
        return 1


def _run(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=8).stdout.strip()
    except Exception:
        return ""


def _startup_health():
    """C-v1~C-v4 启动健康检查(CLD更新防弹窗防孤儿规范)"""
    print("  ── 启动健康 (C-v1~C-v4) ──")
    results = []
    # C-v1: dsh 命令行含 --no-open
    dsh = _run('pgrep -f "bin\\.js web" | head -1')
    if dsh:
        cmdline = _run(f'ps -p {dsh} -o command=')
        v1 = "--no-open" in cmdline
        print(f"  {'✅' if v1 else '❌'} C-v1 无弹窗: dsh pid {dsh} 含 --no-open" if v1 else f"  ❌ C-v1 dsh pid {dsh} 缺 --no-open (弹窗风险)")
        results.append(v1)
    else:
        print("  ℹ️ C-v1 dsh 未运行(跳过)")
    # C-v2: 无新浏览器打开(opening 记录时间)
    logf = os.path.expanduser("~/.cld/logs/dsh-web.log")
    opening = _run(f'grep "opening the default browser" "{logf}" 2>/dev/null | tail -1')
    if opening:
        print(f"  ⚠️ C-v2 历史有 opening 记录(需确认非本次启动)")
    else:
        print("  ✅ C-v2 无 opening 记录")
    # C-v3: 单实例(壳≤1 + dsh≤1)
    n_cld = _run('pgrep -f "CLD\\.app/Contents/MacOS/CLD" | wc -l').strip()
    try:
        n = int(n_cld)
        v3 = n <= 3  # 壳+dsh+可能的helper少量
        print(f"  {'✅' if v3 else '❌'} C-v3 实例数: {n} {'(疑似孤儿)' if n > 3 else ''}")
        results.append(v3)
    except Exception:
        print("  ⚠️ C-v3 实例数解析失败")
    return all(results) if results else True


def cmd_verify():
    s = snapshot()
    st = read_state()
    cur = st.get("current") or {}
    ok = cur.get("asar_sha1") == s.get("asar_sha1")
    print("=== verify ===")
    print(f"  asar sha1: {s.get('asar_sha1')}")
    print(f"  登记版本: {cur.get('ver') or '(无)'} sha1 {cur.get('asar_sha1')}")
    print("  ✅ 一致" if ok and cur else "  ⚠️ 不一致/未登记")
    health = _startup_health()
    if not (ok and cur):
        return 1
    return 0 if health else 1


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    cmd = sys.argv[1]
    if cmd == "status":
        return cmd_status()
    if cmd == "tag":
        ver = sys.argv[2] if len(sys.argv) > 2 else ""
        if not ver:
            print("需版本号: guard-cld-release tag v0.4.1 --note 说明"); return 1
        note = ""
        if "--note" in sys.argv:
            note = sys.argv[sys.argv.index("--note") + 1]
        return cmd_tag(ver, note)
    if cmd == "history":
        return cmd_history()
    if cmd == "rollback":
        tgt = sys.argv[2] if len(sys.argv) > 2 else ""
        if not tgt:
            print("需回滚目标: 备份文件名或关键词"); return 1
        return cmd_rollback(tgt)
    if cmd == "verify":
        return cmd_verify()
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
