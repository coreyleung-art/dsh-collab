      "tool": "~/dsh-collab/scripts/channel-denominator.py",
      "probe_args": [
        "--selftest"
      ],
      "probe": {
        "expect_rc": 0,
        "must_contain": [
          "fails=0"
        ]
      },
      "mutation": {
        "kind": "py_replace",
        "find": "DOMAIN_EXCLUDE_PATTERNS = [",
        "replace": "DOMAIN_EXCLUDE_PATTERNS = [] and ["
      },
      "expect_red_marker": "FAIL"
    },
    {
