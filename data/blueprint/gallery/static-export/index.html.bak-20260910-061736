function tipText(n){
  if(n.kind==='bizdev')return n.dim+' · '+n.assetCount+' 项资产';
  if(n.kind==='bizasset')return n.name+' · '+(n.blueprint||'未归')+(n.isOriginal?' · 💎':'');
