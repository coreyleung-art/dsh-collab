function bpColor(id){
  const key=String(id).replace(/-/g,'_');
  if(DIM_COLORS[key])return DIM_COLORS[key];
  const dim=DIM_LABEL[id]||'';
  if(dim==='业务')return '#6ea8ff';if(dim==='技术')return '#e06c75';if(dim==='底座')return '#c678dd';
