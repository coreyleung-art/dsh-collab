  const isKnowledge = rel.mode==='knowledge';
  const isSysGraph = rel.mode==='system-graph';
  const isPhi = rel.mode==='philosophy';
  const isOrig = rel.mode==='original';
  const isHw = rel.mode==='hardware';
  const isHwComm = rel.mode==='hwcomm';
