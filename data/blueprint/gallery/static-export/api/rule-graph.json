{"nodes": [{"id": "rule:R001", "label": "红绿灯互斥协议", "short": "R001", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "同源操作（同文件/后台/任务）前必须 agent_light 查询 → agent_lock 独占 → 操作完 agent_unlock", "agents": ["全部"], "blueprints": ["agent-network", "gene-bank", "distributed-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool"}, {"id": "rule:R002", "label": "通道分级纪律", "short": "R002", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "STATUS/ACK→黑板；TASK→p2p；COLLAB→线程；EVENT→事件总线；BATCH→邮箱", "agents": ["星桥"], "blueprints": ["agent-network", "distributed-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool+manual"}, {"id": "rule:R003", "label": "黑板消息发送规范", "short": "R003", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "写黑板消息必须用 python json.dumps 生成 JSON 文件再 curl 发送（--data-binary @file）", "agents": ["星桥"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "manual"}, {"id": "rule:R004", "label": "central-inbox 注入目标显式配置", "short": "R004", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "每台设备 central-inbox 必须显式设 CENTRAL_AGENT=<本机中枢会话id>，禁止依赖自动找第一个会话", "agents": ["明鉴"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "manual"}, {"id": "rule:R005", "label": "永续通讯协议 CCEP", "short": "R005", "color": "#2ac3de", "dim": "架构", "kind": "rule", "r": 10, "status": "enforced", "summary": "通道迭代必须用旧通道投递新通道，验证可行才切换；除死机外永续通讯", "agents": ["全部"], "blueprints": ["distributed-network"], "global": true, "scope": "all-bus-devices", "enforcedBy": "process"}, {"id": "rule:R006", "label": "插件化工具化标准（10 项）", "short": "R006", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "凡插件化/工具化默认按 10 项：dsh 插件形态/TCC 检测/CLD 自适应/dsh 版本自适应/文档化/版本管理/统一日志/自动落链/CLI 治理/约束前置·Lean4 逻辑门(v2.1 2026-09-06 范围扩: 含服务器化 comm-layer 工具/服务)", "agents": ["明鉴"], "blueprints": ["agent-network", "blueprint-platform", "mtm", "laodeng-app"], "global": false, "scope": "all-bus-devices", "enforcedBy": "review"}, {"id": "rule:R007", "label": "删前考古纪律", "short": "R007", "color": "#56b6c2", "dim": "数据", "kind": "rule", "r": 10, "status": "enforced", "summary": "删除/清理共享资源前先跑 pre-delete-archaeology.py 考古评估", "agents": ["4787d717"], "blueprints": ["blueprint-platform", "gene-bank"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool"}, {"id": "rule:R008", "label": "规则治理流程", "short": "R008", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "新规则提交流程：提交→总线审核→裁决评估→吸收→同步泛化所有侧", "agents": ["星桥"], "blueprints": ["blueprint-platform"], "global": false, "scope": "all-bus-devices", "enforcedBy": "process"}, {"id": "rule:R009", "label": "角色命名标准（智能体自命名-设备-角色）", "short": "R009", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "智能体身份 = 自命名-设备-角色（如 星桥-mac-mini-协调者）；自命名有温度（智能体自己选）；会话代码 session-xxx 隐藏", "agents": ["fa1f9150"], "blueprints": [], "global": false, "scope": "all-bus-devices", "enforcedBy": "review"}, {"id": "rule:R010", "label": "新插件评估（独立 vs 纳入已有）", "short": "R010", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "任何新插件需求先评估：独立插件 vs 纳入已有子插件 vs 复用已有，给用户对比表+定位+理由，用户决策后才建", "agents": ["星桥"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool"}, {"id": "rule:R012", "label": "完整体传输契约（CHECKS 七要素）", "short": "R012", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "所有端对端/总线对端侧传输必须是完整体（开箱即用零二次开发）：内容完整/校验和/可执行/上下文/版本可溯/自检/可回滚", "agents": ["全部"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool+manual"}, {"id": "rule:R013", "label": "重启救援协议", "short": "R013", "color": "#2ac3de", "dim": "架构", "kind": "rule", "r": 10, "status": "enforced", "summary": "互为救援设备：重启方留准备信息给救援方观察，异常发救援信号，仅非破坏性救援，禁止破坏性操作", "agents": ["守望"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool+manual"}, {"id": "rule:R014", "label": "插件自查门（依赖完整性）", "short": "R014", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "每个 dsh 插件必须内置 selfcheck.js 自查门：apply 最前检查 peerDeps 可解析/关键符号导入/type:module 匹配，缺模块写黑板告警 data/ops/plugin-selfcheck/，不等到崩溃或被外部检查发现", "agents": ["守链", "驿使"], "blueprints": ["blueprint-platform"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool+manual"}, {"id": "rule:R016", "label": "CLD 统一治理", "short": "R016", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "CLD 开发统一版本/日志/文档管理+落链，单治理中枢，迭代回流，热迭代规划，端侧分发，沙箱模拟隔离生产升级", "agents": ["星桥"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": "tool+manual"}, {"id": "rule:R017", "label": "抽象事务图形化表达（visualization）", "short": "R017", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "与用户沟通抽象/结构/流程/对比类内容时，优先用 dsh-ui 图形组件（mermaid 图/表格/chart/steps/timeline），纯问答除外", "agents": ["fa1f9150", "全部", "星桥"], "blueprints": ["agent-network", "laodeng-app"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R018", "label": "无关消息反馈链（noise-feedback）", "short": "R018", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "智能体收到无关消息 → noise report（黑板 data/audit/noise-reports/）→ noise-scan 30min 聚合 → 污染源治理 → 周报回看", "agents": ["星桥"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R019", "label": "概念精确性纪律（不可混淆·不可猜测）", "short": "R019", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "术语/概念不可混淆不可猜测：查证使用/禁混淆/禁猜测/用错即纠/新概念登记数据字典", "agents": ["全部"], "blueprints": [], "global": true, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R020", "label": "新工具蓝图适配闭环（tool-blueprint-l", "short": "R020", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "任何新工具出现（工具/插件/MCP/技能/脚本）→ 同步明鉴（蓝图主编）→ 明鉴分析是否适用蓝图/适用哪一块 → 纳入新工具闭环交付规则", "agents": ["f38244df", "明鉴"], "blueprints": ["blueprint-platform", "mtm"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R021", "label": "行为验证优先，日志缺失≠功能缺失", "short": "R021", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "诊断系统故障时先行为验证（能用吗/文件在写吗/数据在涨吗），再用日志考古；禁止用『日志里没有某条字符串』推断『功能不存在』", "agents": ["守灯塔"], "blueprints": ["rule-judge"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R022", "label": "治理工具不得制造同类问题（抽出必浓缩去重再注入）", "short": "R022", "color": "#c678dd", "dim": "工程", "kind": "rule", "r": 10, "status": "enforced", "summary": "队列/上下文治理工具的『抽出→浓缩→去重→合并→精简注入』全链路必须完整执行，禁止跳过浓缩去重直接原样回灌（否则制造比原风暴更糟的历史上下文回灌）", "agents": ["星桥"], "blueprints": ["agent-network"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R024", "label": "子代理新建前评估纪律（复用优先）", "short": "R024", "color": "#6ea8ff", "dim": "协作", "kind": "rule", "r": 10, "status": "enforced", "summary": "新建子代理前必查现有（subagent-govern audit/agent_profiles），同类型可复用则复用不新建；任务完成即归档不做常驻", "agents": ["2a15e6b1", "fa1f9150", "明鉴"], "blueprints": ["memory-governance"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R025", "label": "学习调查类任务提前并行（prep-ahead）", "short": "R025", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "蓝图 gate 只卡『执行类』任务（需前置数据/环境）；『学习/调查类』前置准备不受 gate 限制，可提前领卡并行抢跑备料", "agents": ["f38244df", "fa1f9150"], "blueprints": ["agent-network", "rule-judge"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R026", "label": "批量/合规操作强制 L3 用户确认（J45 强化）", "short": "R026", "color": "#34c77b", "dim": "运营", "kind": "rule", "r": 10, "status": "enforced", "summary": "批量操作（≥2 店）或合规边界操作（平台活动/报名/上下架）命中 L3 必须弹用户确认，无确认拒绝执行；手册行动项须标注档位；执行后必须同步用户本人", "agents": ["aa528267"], "blueprints": [], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R027", "label": "自动化人类开关锁（Human Kill-Switch", "short": "R027", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "能力（能不能）与权限（该不该/敢不敢）永远分离：测试区验证能力，生产区人类掌权；AGI 获用户认可前，所有 AI 自动化蓝图生产区必须有『人类开关锁』（默认 OFF + 人类授权 ON + 一键熔断 + 审计留痕）", "agents": ["f38244df", "fa1f9150"], "blueprints": ["agent-network", "aistartup", "banking", "blueprint-platform", "flowernet", "flowernet-erp", "flowernet-miniapp", "flowernet-platform", "flowernet-website", "memory-governance", "rule-judge", "gene-bank", "mtm", "laodeng-app"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R028", "label": "批量/高险操作决策依据六问前置（J45 扩展）", "short": "R028", "color": "#34c77b", "dim": "运营", "kind": "rule", "r": 10, "status": "enforced", "summary": "批量/高险操作（L3）确认前必须附决策依据六问核查：①款式（SPU）②商品（可售）③库存（备货）④人力（履约）⑤价格（盈亏平衡）⑥资材周转（非标不备/复用/预售）——approval_request 带决策依据字段", "agents": ["2a15e6b1", "aa528267", "fa1f9150"], "blueprints": [], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R029", "label": "操作原语外部性分级锁（J45 深化）", "short": "R029", "color": "#34c77b", "dim": "运营", "kind": "rule", "r": 10, "status": "enforced", "summary": "行为原语按外部性分级设锁：L3（外部性≥8）→ automation-switch Unlocked(Authorization) 类型级锁；L2（4-7）→ VerifiedGate 验证门；L0 → 自由执行", "agents": ["6ed4daf2", "aa528267", "f38244df", "fa1f9150"], "blueprints": ["rule-judge"], "global": false, "scope": "all-bus-devices", "enforcedBy": ""}, {"id": "rule:R030", "label": "自动化结果真实性原则（无验证的成功=未成功）", "short": "R030", "color": "#e06c75", "dim": "治理", "kind": "rule", "r": 10, "status": "enforced", "summary": "自动化操作的成功判定必须基于业务权威字段验证（API响应/状态复查），禁止用 UI 文本/元素存在性判定成功；无验证的成功=未成功禁止上报；L3 结果须独立复核", "agents": ["a3bc8cba", "fa1f9150"], "blueprints": ["rule-judge"], "global": false, "scope": "all-bus-d